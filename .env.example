# Copiar este archivo a ".env" y completar con tu propia API key.
# NUNCA subir el archivo ".env" real al repositorio (ya está en .gitignore).

# API key de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modelo a usar. gpt-4o-mini por defecto (buena relación costo/calidad para
# esta tarea). Si se cambia, actualizar también PRICING_USD_PER_1M_TOKENS
# en src/llm_client.py con el precio correcto del modelo elegido.
OPENAI_MODEL=gpt-4o-mini
